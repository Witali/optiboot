# Optional convenience targets for the single-source dual-edition builder.
# Run: make -f Makefile.dual compact MCU=atmega328p
PYTHON ?= python3
MCU ?= atmega328p
SIGNATURE_SOURCE ?= auto
BAUD ?= auto
JOBS ?= 6
OUTPUT ?= output/dual
F_CPU ?=
CLOCK_SOURCE ?=
COMMON := --mcu $(MCU) --signature-source $(SIGNATURE_SOURCE) --baud $(BAUD) --output-dir $(OUTPUT)
COMMON += $(if $(F_CPU),--f-cpu $(F_CPU),) $(if $(CLOCK_SOURCE),--clock-source $(CLOCK_SOURCE),)
.PHONY: compact full both matrix dual_test
compact:
	$(PYTHON) build_dual.py --edition compact $(COMMON)
full:
	$(PYTHON) build_dual.py --edition full $(COMMON)
both:
	$(PYTHON) build_dual.py --edition both $(COMMON)
matrix:
	$(PYTHON) build_dual.py --edition both --all --jobs $(JOBS) --signature-source $(SIGNATURE_SOURCE) --output-dir $(OUTPUT)
dual_test:
	DUAL_OUTPUT_ROOT=$(OUTPUT) $(PYTHON) -m unittest mini_tests.test_dual_editions -v
